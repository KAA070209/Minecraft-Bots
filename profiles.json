    "logging": {
      "level": "info",
      "file": "./logs/{name}.log",
      "logChat": true
    },
    "console": {
      "enabled": true
    },
    "chatGame": {
      "enabled": true,
      "delayMs": 20,
      "minIntervalMs": 700,
      "solo": true,
      "soloWindowMs": 10000,
      "storeFile": "logs/chatgame-memory-{username}.json",
      "mathFirst": true,
      "debugRaw": false
    }
  },
