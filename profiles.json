{
  "defaults": {
    "server": {
      "host": "minesive.com",
      "port": 25565
    },
    "register": {
      "enabled": true,
      "mode": "register",
      "commandTemplate": "/register {password}",
      "delayMs": 1500,
      "retryMs": 8000,
      "maxAttempts": 3
    },
    "version": null,
    "afk": {
      "mode": "look",
      "minIntervalMs": 25000,
      "maxIntervalMs": 55000
    },
    "survival": {
      "autoEat": true,
      "rescue": true
    },
    "combat": {
      "enabled": true,
      "range": 12,
      "approach": true,
      "attackRange": 3,
      "attackCooldownMs": 100,
      "cpsMin": 8,
      "cpsMax": 14,
      "retreatBelowHealth": 6
    },
    "shop": {
      "enabled": false,
      "mode": "gui",
      "command": "/shop",
      "items": ["carrot", "wheat", "cooked_beef"],
      "amount": 64,
      "intervalMs": 300000,
      "dumpWhenFull": true
    },
    "farm": {
      "enabled": true,
      "autoDiscover": true,
      "searchRadius": 32,
      "area": { "x": 0, "y": 64, "z": 0, "radius": 8 },
